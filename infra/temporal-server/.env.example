TEMPORAL_IMAGE=temporalio/server:1.32.0
TEMPORAL_ADMINTOOLS_IMAGE=temporalio/admin-tools:1.32.0

# Must match POSTGRES_USER in ../postgres/.env
POSTGRES_USER=temporal

# Which address on your machine the port is opened on.
# 127.0.0.1 = only this machine can connect. 0.0.0.0 = anyone on your network can.
BIND_HOST=127.0.0.1

# Apps and the CLI connect to 127.0.0.1:7233
# Change it if 7233 is already used on your machine.
TEMPORAL_HOST_PORT=7233

TEMPORAL_NAMESPACE=temporal-lab
