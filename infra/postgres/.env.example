POSTGRES_IMAGE=postgres:16.10-alpine
POSTGRES_USER=temporal

# Which address on your machine the port is opened on.
# 127.0.0.1 = only this machine can connect. 0.0.0.0 = anyone on your network can.
BIND_HOST=127.0.0.1

# DBeaver / psql connect to 127.0.0.1:5432 (user: temporal, password: ../secrets/db_password.txt)
# Change it if 5432 is already used on your machine.
POSTGRES_HOST_PORT=5432
