AZURITE_IMAGE=mcr.microsoft.com/azure-storage/azurite:3.37.0

# 127.0.0.1 = only this machine can connect. 0.0.0.0 = anyone on your network can.
BIND_HOST=127.0.0.1

# Apps call http://127.0.0.1:10000/devstoreaccount1 (Azurite's built-in dev account).
# Change it if 10000 is already used on your machine.
AZURITE_BLOB_HOST_PORT=10000
