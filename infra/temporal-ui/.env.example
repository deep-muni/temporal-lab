TEMPORAL_UI_IMAGE=temporalio/ui:2.56.0

# Which address on your machine the port is opened on.
# 127.0.0.1 = only this machine can connect. 0.0.0.0 = anyone on your network can.
BIND_HOST=127.0.0.1

# Open http://127.0.0.1:8080
# Change it if 8080 is already used on your machine.
TEMPORAL_UI_HOST_PORT=8080

TEMPORAL_DEFAULT_NAMESPACE=temporal-lab
