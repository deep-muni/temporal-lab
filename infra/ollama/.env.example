OLLAMA_IMAGE=ollama/ollama:0.40.13

# 127.0.0.1 = only this machine can connect. 0.0.0.0 = anyone on your network can.
BIND_HOST=127.0.0.1

# Apps call http://127.0.0.1:11434
# Change it if 11434 is already used on your machine.
OLLAMA_HOST_PORT=11434

# Space-separated models downloaded on first start: one for summaries, one for embeddings.
OLLAMA_MODELS=qwen3.5:4b qwen3-embedding:0.6b
