{
  "name": "nest-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "start": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- nest start",
    "start:dev": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- nest start --watch",
    "start:worker": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- nest start --path tsconfig.worker.json --entryFile worker --watch",
    "start:debug": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.cjs",
    "dotenvx": "dotenvx",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "orm:sync": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- prisma generate",
    "db:migrate:dev": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- prisma migrate dev",
    "db:migrate:create": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- prisma migrate dev --create-only",
    "db:migrate:reset": "dotenvx run -f .env.local -f .env --ignore=MISSING_ENV_FILE -- prisma migrate reset",
    "db:migrate:prod": "prisma migrate deploy"
  },
  "dependencies": {
    "@azure/storage-blob": "12.34.0",
    "@dotenvx/dotenvx": "^2.38.2",
    "@langchain/core": "1.3.2",
    "@langchain/textsplitters": "1.0.2",
    "@nestjs-cls/transactional": "4.0.2",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "nestjs-cls": "7.0.2",
    "ollama": "0.6.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "^5.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "12.2.1",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
